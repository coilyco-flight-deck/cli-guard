// specverb proving-slice Guardfile: the forgejo repo get/create/delete trio.
// No `op` bindings - each grant's verb+resource resolve to an operationId by
// convention (specverb.resolveOp). Policy body is flat declarative sentences;
// quotes live only in the header.
wrap ward ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "https://forgejo.coilysiren.me/api/v1"
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/api-token"
    }

    can get repo
    can create repo
    can delete repo {
        describe "irreversible: deletes the repo and all its data"
    }
}
