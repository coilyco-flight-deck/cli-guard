// specverb proving-slice Guardfile: the forgejo repo get/create/delete trio.
// Each `can` binds its op explicitly; the engine carries no expansion table.
// Policy body is flat declarative sentences; quotes live only in the header.
wrap ward ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "https://forgejo.coilysiren.me/api/v1"
    auth header-token {
        header Authorization
        prefix "token "
        ssm "/forgejo/api-token"
    }

    can get repo { op "repoGet" }
    can create repo { op "createCurrentUserRepo" }
    can delete repo {
        op "repoDelete"
        describe "irreversible: deletes the repo and all its data"
    }
}
