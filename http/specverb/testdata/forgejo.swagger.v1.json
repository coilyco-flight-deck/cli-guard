{
  "swagger": "2.0",
  "info": { "title": "Forgejo API (M0 proving subset)", "version": "1.0" },
  "basePath": "/api/v1",
  "securityDefinitions": {
    "AuthorizationHeaderToken": {
      "description": "API tokens must be prepended with \"token\" followed by a space.",
      "type": "apiKey", "name": "Authorization", "in": "header"
    }
  },
  "paths": {
    "/repos/{owner}/{repo}": {
      "get": {
        "operationId": "repoGet",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": {}, "404": {} }
      },
      "delete": {
        "operationId": "repoDelete",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "204": {}, "403": {}, "404": {} }
      }
    },
    "/user/repos": {
      "post": {
        "operationId": "createCurrentUserRepo",
        "parameters": [
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/CreateRepoOption" } }
        ],
        "responses": { "201": {}, "409": {}, "422": {} }
      }
    },
    "/repos/{owner}/{repo}/issues": {
      "get": {
        "operationId": "issueListIssues",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" },
          { "name": "state", "in": "query", "type": "string", "description": "whether issue is open or closed" },
          { "name": "labels", "in": "query", "type": "string", "description": "comma separated list of labels" },
          { "name": "page", "in": "query", "type": "integer", "description": "page number of results to return" },
          { "name": "limit", "in": "query", "type": "integer", "description": "page size of results" }
        ],
        "responses": { "200": {} }
      },
      "post": {
        "operationId": "issueCreateIssue",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/CreateIssueOption" } }
        ],
        "responses": { "201": {}, "422": {} }
      }
    },
    "/repos/{owner}/{repo}/issues/{index}": {
      "patch": {
        "operationId": "issueEditIssue",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" },
          { "name": "index", "in": "path", "required": true, "type": "integer" },
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/EditIssueOption" } }
        ],
        "responses": { "201": {}, "404": {} }
      }
    },
    "/repos/{owner}/{repo}/issues/{index}/labels": {
      "post": {
        "operationId": "issueAddLabel",
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" },
          { "name": "index", "in": "path", "required": true, "type": "integer" },
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/IssueLabelsOption" } }
        ],
        "responses": { "200": {} }
      }
    },
    "/repos/{owner}/{repo}/releases/{id}/assets": {
      "post": {
        "operationId": "repoCreateReleaseAttachment",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "owner", "in": "path", "required": true, "type": "string" },
          { "name": "repo", "in": "path", "required": true, "type": "string" },
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          { "name": "name", "in": "query", "type": "string" },
          { "name": "attachment", "in": "formData", "type": "file" },
          { "name": "external_url", "in": "formData", "type": "string" }
        ],
        "responses": { "201": {} }
      }
    }
  },
  "definitions": {
    "CreateRepoOption": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Name of the repository to create" },
        "description": { "type": "string", "description": "Description of the repository to create" },
        "private": { "type": "boolean", "description": "Whether the repository is private" },
        "auto_init": { "type": "boolean", "description": "Whether the repository should be auto-initialized" },
        "default_branch": { "type": "string", "description": "DefaultBranch of the repository" }
      }
    },
    "CreateIssueOption": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "description": "issue title" },
        "body": { "type": "string", "description": "issue body" },
        "assignees": { "type": "array", "items": { "type": "string" }, "description": "usernames to assign" },
        "labels": { "type": "array", "items": { "type": "integer" }, "description": "label ids to apply" },
        "milestone": { "type": "integer", "description": "milestone id" }
      }
    },
    "EditIssueOption": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "issue title" },
        "body": { "type": "string", "description": "issue body" },
        "state": { "type": "string", "description": "open or closed" }
      }
    },
    "IssueLabelsOption": {
      "type": "object",
      "properties": {
        "labels": { "type": "array", "items": {}, "description": "label ids or names" }
      }
    }
  }
}
